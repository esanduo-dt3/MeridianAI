# Copy to .env and fill in. .env is git-ignored. Never commit real values.
SUPABASE_URL=https://igzjmigtofnpnsaaxmul.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Bypasses row-level security. Backend only; never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase -> Connect -> Session pooler string, with the database password. Used only by scripts/db/migrate.sh.
DATABASE_URL=
# --- Generation: Claude on Amazon Bedrock (D-046) ---
# Set to "gemini" to run generation on Gemini again; embeddings stay on Gemini either way.
# GENERATION_PROVIDER=bedrock
AWS_REGION=us-east-2
# Leave both blank to let the AWS SDK resolve credentials (profile, instance role).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Inference-profile ARNs from the Bedrock console, or plain Bedrock model ids.
# Both are Haiku 4.5 today: Sonnet 4 is refused by Bedrock as a legacy model
# (D-049). Point ANSWER at a current Sonnet to restore the strong/fast split.
BEDROCK_ANSWER_MODEL=
BEDROCK_FAST_MODEL=
# Sonnet 5 and Opus 5 reject sampling settings; set this false for those models.
# BEDROCK_SAMPLING=true
# Optional, comma separated: tried before falling back to the other role's model.
# BEDROCK_FALLBACK_MODELS=

# Embeddings only (Claude has no embedding model, D-046). A free Google AI Studio key works.
GEMINI_API_KEY=
# Optional. Models tried when the answer or fast model is out of quota, comma separated.
# GEMINI_FALLBACK_MODELS=gemini-3-flash-preview
# Cross-encoder reranking: dash.voyageai.com -> API Keys.
VOYAGE_API_KEY=
# One origin, or several separated by commas (e.g. production and a preview URL). "*" is refused.
FRONTEND_ORIGIN=http://localhost:5173
ENVIRONMENT=local

# Per-user rate limits (D-041). Defaults shown; raise them with a paid model key.
# RATE_LIMIT_ASK_PER_MINUTE=6
# RATE_LIMIT_ASK_PER_HOUR=60
# RATE_LIMIT_CHAT_PER_MINUTE=10
# RATE_LIMIT_CHAT_PER_HOUR=120
# RATE_LIMIT_UPLOAD_PER_MINUTE=10
# RATE_LIMIT_UPLOAD_PER_HOUR=60

# Upload limits (D-041).
# MAX_DOCX_UNCOMPRESSED_BYTES=209715200
# MAX_DOCX_ENTRIES=5000
# MAX_PDF_PAGES=1500
# MAX_PASSAGES_PER_DOCUMENT=3000
