# Copy to .env and fill in. .env is git-ignored. Never commit real values.
SUPABASE_URL=https://igzjmigtofnpnsaaxmul.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Bypasses row-level security. Backend only; never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase -> Connect -> Session pooler string, with the database password. Used only by scripts/db/migrate.sh.
DATABASE_URL=
# Model provider for embeddings and answers. A free Google AI Studio key works (D-032).
GEMINI_API_KEY=
# Optional. Models tried when the answer or fast model is out of quota, comma separated.
# GEMINI_FALLBACK_MODELS=gemini-3-flash-preview
# Cross-encoder reranking: dash.voyageai.com -> API Keys.
VOYAGE_API_KEY=
# One origin, or several separated by commas (e.g. production and a preview URL). "*" is refused.
FRONTEND_ORIGIN=http://localhost:5173
ENVIRONMENT=local

# Per-user rate limits (D-041). Defaults shown; raise them with a paid model key.
# RATE_LIMIT_ASK_PER_MINUTE=6
# RATE_LIMIT_ASK_PER_HOUR=60
# RATE_LIMIT_CHAT_PER_MINUTE=10
# RATE_LIMIT_CHAT_PER_HOUR=120
# RATE_LIMIT_UPLOAD_PER_MINUTE=10
# RATE_LIMIT_UPLOAD_PER_HOUR=60

# Upload limits (D-041).
# MAX_DOCX_UNCOMPRESSED_BYTES=209715200
# MAX_DOCX_ENTRIES=5000
# MAX_PDF_PAGES=1500
# MAX_PASSAGES_PER_DOCUMENT=3000
